# dsp.inc -- the equates of dsp.s (the effects DSP: its sample mixer, the bank, the voices), included by
# cnv_main.s before any code, since audio.s and cnv_main.s use them too.

.include "dsp_equ.inc"              # generated by tools/dsp_mixer.py

# ---- DSP_HOST (platformcnv.inc), zeroed by the loader with the whole application area ------------------------
.equ DV_STATE,     DSP_HOST + 0x00  # DS_* below
.equ DV_FAIL,      DSP_HOST + 0x04  # why the DSP is not used (DF_* codes below), 0 = it is
.equ DV_DWAIT,     DSP_HOST + 0x08  # the firmware's DSP routines (`calls` entries), as DspFind found them
.equ DV_DREGWR,    DSP_HOST + 0x0C  #   2x16 register write (d0 = register, d1 = high half, (0x10, sp) = low half)
.equ DV_DREGRD,    DSP_HOST + 0x10  #   2x16 register read (d0 = register)
.equ DV_DIDXWR,    DSP_HOST + 0x14  #   guarded index write (d0 = index)
.equ DV_DDATARD,   DSP_HOST + 0x18  #   guarded data-port read
.equ DV_DDATAWR,   DSP_HOST + 0x1C  #   guarded data-port write (d0 = 0x9C4, d1 = 16 bits)
.equ DV_DDEAD,     DSP_HOST + 0x20  #   the firmware's "DSP dead" flag (byte)
.equ DV_DDOWN,     DSP_HOST + 0x24  #   its "kernel downloaded" flag (byte)
.equ DV_FOUND,     DSP_HOST + 0x28  # DFB_* bits
.equ DV_SYSCON,    DSP_HOST + 0x2C
.equ DV_DMAC0,     DSP_HOST + 0x30  # DMAC0, IIEP0, IMEP0, CEP0 as found (put back at the end)
.equ DV_IIEP0,     DSP_HOST + 0x34
.equ DV_IMEP0,     DSP_HOST + 0x38
.equ DV_CEP0,      DSP_HOST + 0x3C
.equ DV_DMASTAT,   DSP_HOST + 0x40
.equ DV_SLOT0_HI,  DSP_HOST + 0x44  # unit 0's CALL slot as found (the firmware's): bits 47-32,
.equ DV_SLOT0_LO,  DSP_HOST + 0x48  #   bits 31-0
.equ DV_SLOT9_HI,  DSP_HOST + 0x4C  # unit 9's
.equ DV_SLOT9_LO,  DSP_HOST + 0x50
.equ DV_HOOKED,    DSP_HOST + 0x54  # bit 0: unit 0's slot is ours, bit 1: unit 9's
.equ DV_U9,        DSP_HOST + 0x58  # 1 when unit 9's slot is the kernel's form: it is hooked too
.equ DV_RBFAIL,    DSP_HOST + 0x5C  # the last readback stopped early
.equ DV_MODE,      DSP_HOST + 0x60  # the sound mode (audio.s): MODE_DSP, MODE_TG, MODE_OFF
.equ DV_READY,     DSP_HOST + 0x64  # 1: the mixer is loaded and the whole bank is in SDRAM
.equ DV_BK_RES,    DSP_HOST + 0x68  # the bank upload: the resource id being sent (or the next to look at)
.equ DV_BK_OFS,    DSP_HOST + 0x6C  #   bytes of its samples sent; -1: its file is not read yet
.equ DV_BK_LEN,    DSP_HOST + 0x70  #   bytes to send (whole copy steps)
.equ DV_BK_DONE,   DSP_HOST + 0x74  #   words sent so far, all sounds
.equ DV_BK_T0,     DSP_HOST + 0x78  #   this call's start (ms)
.equ DV_BK_SENT,   DSP_HOST + 0x7C  # 1: this run sent the bank; 2: it was already in SDRAM (the marker)
.equ DV_PEND,      DSP_HOST + 0x80  # the commands not yet sent: bit v start, 8+v rate and volume, 16+v stop
.equ DV_LASTCALLS, DSP_HOST + 0x84  # the watchdog (DspWatch): converter calls last seen,
.equ DV_LASTMS,    DSP_HOST + 0x88  #   and when they last changed
.equ DV_BUSY,      DSP_HOST + 0x8C  # DspFlush calls that found MSGR6 still not 0 (the mixer behind)
.equ DV_FLUSHES,   DSP_HOST + 0x90  # command masks sent
.equ DV_STALLS,    DSP_HOST + 0x94  # BankStep calls in a row in which the mixer did not finish a copy
.equ DV_SIGN0,     DSP_HOST + 0x98  # DspFindStep: sig_dspwait's hits, and the first
.equ DV_SIGA0,     DSP_HOST + 0x9C
.equ DV_SIGN1,     DSP_HOST + 0xA0  # sig_dspregs's
.equ DV_SIGA1,     DSP_HOST + 0xA4
.equ DV_HB0,       DSP_HOST + 0xA8  # MSGR7 when the slots were hooked (the mixer's heartbeat)
.equ DV_TMP,       DSP_HOST + 0xAC
.equ DV_CMDS,      DSP_HOST + 0xC0  # 8 x 5 u32: the command records as the mixer reads them (BASE, INC, END,
                                    #   LOOP, VOL), uploaded as they are: low half first, as the DMA wants them
.equ DV_NAME,      DSP_HOST + 0x180 # 16 bytes: "AWRxx.AW", the sound file being read
.equ DV_MODETXT,   DSP_HOST + 0x1A0 # 48 bytes: the help screen's sound line (DspModeText)
.equ DV_RBBUF,     DSP_HOST + 0x200 # 0x200 bytes: words read back (6 bytes a PM word, 4 a DM word)
.equ RB_WORDS,     0x50             # PM words read back at a time (0x50 x 6 = 0x1E0 bytes)

.equ DS_NONE,      0                # DV_STATE: not prepared
.equ DS_BANK,      1                #   prepared and hooked; the bank is being sent
.equ DS_READY,     2                #   ready (DV_READY)
.equ DS_OFF,       3                #   given up (DV_FAIL), or released: the firmware's slots are back

.equ DFB_WAIT,     1                # DV_FOUND bits
.equ DFB_REGS,     2
.equ DFB_IDX,      4
.equ DFB_DATA,     8
.equ DFB_WRITE,    0x10
.equ DFB_ALL,      0x1F

.equ DF_NOTFOUND,  1                # DV_FAIL: the firmware's DSP routines were not all found
.equ DF_DEAD,      2                #   the firmware's dead flag was set
.equ DF_NOTDOWN,   3                #   the kernel was never downloaded
.equ DF_STATE,     4                #   SYSCON, DMAC0 or DMASTAT not as the firmware leaves them
.equ DF_SLOT,      5                #   a slot could not be read back, or is not the kernel's "CALL (0x8xxx) (DB)"
.equ DF_VERIFY,    6                #   the mixer or its variables read back different
.equ DF_HOOK,      7                #   a hooked slot read back different
.equ DF_FILE,      8                #   a sound file could not be read or unpacked
.equ DF_STALL,     9                #   the mixer stopped taking the bank's chunks
.equ DF_RUNDEAD,   10               #   the dead flag was set while the bank was sent
.equ DF_WATCH,     11               #   the firmware stopped calling the converter: released (DspWatch)
.equ DF_RUNTIME,   12               #   the dead flag was set while playing

.equ MODE_DSP,     0                # DV_MODE (audio.s)
.equ MODE_TG,      1
.equ MODE_OFF,     2

# ---- DSP host-port constants (TRM Tables E-15, E-16; the firmware's own values; DSPTONE dsptone.inc) ----------
.equ IOP_SYSCON,   0x00
.equ IOP_EPB0,     0x04
.equ IOP_DMAC0,    0x1C
.equ IOP_DMASTAT,  0x37
.equ IOP_IIEP0,    0x40
.equ IOP_IMEP0,    0x41
.equ IOP_CEP0,     0x42
.equ DMAC_UP_PM,   0xA1             # the firmware's PM upload: DEN | DTYPE | PMODE 10 (16 -> 48)
.equ DMAC_UP_DM,   0x41             # its DM upload: DEN | PMODE 01 (16 -> 32)
.equ DMAC_CLOSE,   0xA0             # what it writes after each block (DEN off)
.equ DMAC_RB_PM,   0xA5             # readback (the ROM dumper's pass 7): the same with TRAN
.equ DMAC_RB_DM,   0x45
.equ DMAC_FLSH,    0x2000
.equ DMAC_KEEP,    0x1FE4           # the bits put back: not DEN, CHEN, the read-only PS/FS, not FLSH
.equ DATA_PORT,    0x9C4            # the firmware's id of the data port 0x9C000000
.equ FS_POLLS,     1000             # DMAC0 reads waiting for EPB0 to hold a word (readback)
.equ COPY_POLLS,   400              # MSGR4 reads waiting for the mixer to finish a copy, per chunk
.equ CMD_POLLS,    20               # MSGR6 reads waiting for the mixer to take the last commands
.equ STALL_CALLS,  40               # BankStep calls in a row without a finished copy: the bank gives up
.equ BANK_MS,      200              # bank work per converter call
.equ WATCH_MS,     5000             # no converter call for this long: the firmware has left (DspWatch)
.equ MARK_MAGIC,   0x42535741       # "AWSB", DM 0x9D00
.equ BT_COUNT,     0x04             # AWBANK.AW (tools/aw_extract.py): entries (one per resource id)
.equ BT_ID,        0x08             #   the bank's id (CRC-32 of its layout and samples)
.equ BT_WORDS,     0x0C             #   words in SDRAM, all sounds
.equ BT_ENT,       0x10             #   the entries: 20 bytes per resource id
.equ BE_ADDR,      0x00             #     the DSP address of its first word (0: not in the bank)
.equ BE_END,       0x04             #     samples (bytes) in all: the first part and the loop
.equ BE_LOOP,      0x08             #     samples in the loop (0: none)
.equ BE_FILE,      0x0C             #     bytes of AWRxx.AW (as MEMLIST.BIN finds it in BANKxx)
.equ BE_SIZE,      0x10             #     bytes unpacked; bit 31: a music instrument (its first 4 samples zeroed)
.equ BE_LEN,       20
.equ BANK_PACKED,  PART_AREA + 0x10000  # where a packed sound file is read; it is unpacked to PART_AREA

